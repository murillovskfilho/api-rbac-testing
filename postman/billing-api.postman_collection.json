{
  "info": {
    "_postman_id": "3f6b8c1a-9d2e-4f7a-8b3c-5e6d7f8a9b0c",
    "name": "Billing API - security & RBAC smoke",
    "description": "End-to-end smoke of the Billing API over real HTTP: tokens from the identity provider, RBAC, tenant isolation, mass assignment, impersonation, idempotency and the invoice lifecycle. Requests are ordered; later ones reuse ids and tokens saved by earlier ones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Applies to every request: API errors must be RFC 7807 and nothing may leak stack traces.",
          "// The IdP's OAuth endpoint is excluded: OAuth 2.0 (RFC 6749) defines its own error format.",
          "if (pm.response.code >= 400 && pm.request.url.getPath().startsWith('/v1')) {",
          "  pm.test('error is an RFC 7807 problem document', () => {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
          "    const body = pm.response.json();",
          "    pm.expect(body).to.include.keys('type', 'title', 'status');",
          "    pm.expect(body.status).to.eql(pm.response.code);",
          "  });",
          "}",
          "pm.test('no stack trace in the body', () => pm.expect(pm.response.text()).to.not.match(/at .+\\.(ts|js):\\d+/));",
          "pm.test('responds in under 1s', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Token: admin (northwind)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 and a bearer token', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().token_type).to.eql('Bearer');",
            "});",
            "pm.collectionVariables.set('adminToken', pm.response.json().access_token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"grant_type\": \"password\",\n  \"username\": \"alice@northwind.test\",\n  \"password\": \"{{demoPassword}}\",\n  \"audience\": \"{{audience}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/idp/oauth/token", "host": ["{{baseUrl}}"], "path": ["idp", "oauth", "token"] }
          }
        },
        {
          "name": "Token: viewer (northwind)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('viewerToken', pm.response.json().access_token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"grant_type\": \"password\",\n  \"username\": \"carol@northwind.test\",\n  \"password\": \"{{demoPassword}}\",\n  \"audience\": \"{{audience}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/idp/oauth/token", "host": ["{{baseUrl}}"], "path": ["idp", "oauth", "token"] }
          }
        },
        {
          "name": "Token: admin of another tenant (contoso)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('otherTenantToken', pm.response.json().access_token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"grant_type\": \"password\",\n  \"username\": \"dan@contoso.test\",\n  \"password\": \"{{demoPassword}}\",\n  \"audience\": \"{{audience}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/idp/oauth/token", "host": ["{{baseUrl}}"], "path": ["idp", "oauth", "token"] }
          }
        },
        {
          "name": "Token: support agent",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('supportToken', pm.response.json().access_token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"grant_type\": \"password\",\n  \"username\": \"sam@support.test\",\n  \"password\": \"{{demoPassword}}\",\n  \"audience\": \"{{audience}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/idp/oauth/token", "host": ["{{baseUrl}}"], "path": ["idp", "oauth", "token"] }
          }
        },
        {
          "name": "Token: wrong password is refused",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('403 invalid_grant, no token', () => {",
            "  pm.response.to.have.status(403);",
            "  pm.expect(pm.response.json().error).to.eql('invalid_grant');",
            "  pm.expect(pm.response.json()).to.not.have.property('access_token');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"grant_type\": \"password\",\n  \"username\": \"alice@northwind.test\",\n  \"password\": \"wrong\",\n  \"audience\": \"{{audience}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/idp/oauth/token", "host": ["{{baseUrl}}"], "path": ["idp", "oauth", "token"] }
          }
        }
      ]
    },
    {
      "name": "2. Invoices",
      "item": [
        {
          "name": "Create invoice (idempotent)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "const body = pm.response.json();",
              "pm.test('201 with a Location header', () => {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(pm.response.headers.get('Location')).to.eql('/v1/invoices/' + body.id);",
              "});",
              "pm.test('totals are computed by the server (2 x 1250 + 8% tax)', () => {",
              "  pm.expect(body).to.include({ subtotalCents: 2500, taxCents: 200, totalCents: 2700, status: 'open' });",
              "});",
              "pm.collectionVariables.set('invoiceId', body.id);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"customer\": \"Newman Freight Co\",\n  \"lines\": [{ \"description\": \"Freight\", \"quantity\": 2, \"unitPriceCents\": 1250 }],\n  \"taxRateBps\": 800\n}" },
            "url": { "raw": "{{baseUrl}}/v1/invoices", "host": ["{{baseUrl}}"], "path": ["v1", "invoices"] }
          }
        },
        {
          "name": "Retry with the same Idempotency-Key replays the result",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 replayed, same invoice', () => {",
            "  pm.response.to.have.status(201);",
            "  pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true');",
            "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('invoiceId'));",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"customer\": \"Newman Freight Co\",\n  \"lines\": [{ \"description\": \"Freight\", \"quantity\": 2, \"unitPriceCents\": 1250 }],\n  \"taxRateBps\": 800\n}" },
            "url": { "raw": "{{baseUrl}}/v1/invoices", "host": ["{{baseUrl}}"], "path": ["v1", "invoices"] }
          }
        },
        {
          "name": "Get invoice exposes no internal fields",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('no internal or tenant fields', () => {",
            "  const body = pm.response.json();",
            "  pm.expect(body).to.not.have.any.keys('internalNotes', 'tenantId');",
            "  pm.expect(pm.response.headers.has('X-Powered-By')).to.be.false;",
            "});"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{viewerToken}}" }],
            "url": { "raw": "{{baseUrl}}/v1/invoices/{{invoiceId}}", "host": ["{{baseUrl}}"], "path": ["v1", "invoices", "{{invoiceId}}"] }
          }
        },
        {
          "name": "Viewer cannot create invoices",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('403 naming the missing permission', () => {",
            "  pm.response.to.have.status(403);",
            "  pm.expect(pm.response.json().detail).to.eql('Missing permission: write:invoices');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{viewerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"customer\": \"Should not exist\",\n  \"lines\": [{ \"description\": \"x\", \"quantity\": 1, \"unitPriceCents\": 1 }]\n}" },
            "url": { "raw": "{{baseUrl}}/v1/invoices", "host": ["{{baseUrl}}"], "path": ["v1", "invoices"] }
          }
        },
        {
          "name": "Mass assignment of status is rejected",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400 listing the forbidden field', () => {",
            "  pm.response.to.have.status(400);",
            "  pm.expect(pm.response.json().errors).to.deep.include({ field: 'status', message: 'is not allowed' });",
            "});"
          ] } }],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"customer\": \"Sneaky\",\n  \"status\": \"paid\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/invoices/{{invoiceId}}", "host": ["{{baseUrl}}"], "path": ["v1", "invoices", "{{invoiceId}}"] }
          }
        }
      ]
    },
    {
      "name": "3. Security",
      "item": [
        {
          "name": "No token: 401 with WWW-Authenticate",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401 with a Bearer challenge', () => {",
            "  pm.response.to.have.status(401);",
            "  pm.expect(pm.response.headers.get('WWW-Authenticate')).to.match(/^Bearer /);",
            "});"
          ] } }],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v1/invoices", "host": ["{{baseUrl}}"], "path": ["v1", "invoices"] }
          }
        },
        {
          "name": "Token with a broken signature: 401",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "const [h, p, s] = pm.collectionVariables.get('adminToken').split('.');",
              "const flipped = (s[0] === 'A' ? 'B' : 'A') + s.slice(1);",
              "pm.collectionVariables.set('brokenToken', [h, p, flipped].join('.'));"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));"
            ] } }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{brokenToken}}" }],
            "url": { "raw": "{{baseUrl}}/v1/invoices", "host": ["{{baseUrl}}"], "path": ["v1", "invoices"] }
          }
        },
        {
          "name": "Another tenant gets 404 for our invoice (BOLA)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('404, not 403: no existence oracle', () => pm.response.to.have.status(404));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{otherTenantToken}}" }],
            "url": { "raw": "{{baseUrl}}/v1/invoices/{{invoiceId}}", "host": ["{{baseUrl}}"], "path": ["v1", "invoices", "{{invoiceId}}"] }
          }
        },
        {
          "name": "Support can read while impersonating",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 and sees the tenant invoice', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('invoiceId'));",
            "});"
          ] } }],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{supportToken}}" },
              { "key": "X-Act-As-Tenant", "value": "northwind" }
            ],
            "url": { "raw": "{{baseUrl}}/v1/invoices/{{invoiceId}}", "host": ["{{baseUrl}}"], "path": ["v1", "invoices", "{{invoiceId}}"] }
          }
        },
        {
          "name": "Support cannot write while impersonating",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('403 read-only', () => {",
            "  pm.response.to.have.status(403);",
            "  pm.expect(pm.response.json().detail).to.eql('Impersonated sessions are read-only.');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{supportToken}}" },
              { "key": "X-Act-As-Tenant", "value": "northwind" }
            ],
            "url": { "raw": "{{baseUrl}}/v1/invoices/{{invoiceId}}/void", "host": ["{{baseUrl}}"], "path": ["v1", "invoices", "{{invoiceId}}", "void"] }
          }
        },
        {
          "name": "Impersonation shows up in the tenant's audit trail",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('latest events include the support agent, flagged as impersonated', () => {",
            "  pm.response.to.have.status(200);",
            "  const events = pm.response.json().data;",
            "  const imp = events.find(e => e.actor === 'sam@support.test');",
            "  pm.expect(imp).to.include({ impersonated: true, actorTenant: 'internal', tenant: 'northwind' });",
            "});"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/v1/audit-events", "host": ["{{baseUrl}}"], "path": ["v1", "audit-events"] }
          }
        }
      ]
    },
    {
      "name": "4. Lifecycle",
      "item": [
        {
          "name": "Pay the invoice",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 paid', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().status).to.eql('paid');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/v1/invoices/{{invoiceId}}/pay", "host": ["{{baseUrl}}"], "path": ["v1", "invoices", "{{invoiceId}}", "pay"] }
          }
        },
        {
          "name": "A paid invoice cannot be voided",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409 conflict', () => pm.response.to.have.status(409));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/v1/invoices/{{invoiceId}}/void", "host": ["{{baseUrl}}"], "path": ["v1", "invoices", "{{invoiceId}}", "void"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "adminToken", "value": "" },
    { "key": "viewerToken", "value": "" },
    { "key": "otherTenantToken", "value": "" },
    { "key": "supportToken", "value": "" },
    { "key": "brokenToken", "value": "" },
    { "key": "invoiceId", "value": "" },
    { "key": "idempotencyKey", "value": "" }
  ]
}
